// The look, by name: what an editor changes. Sizes in vh (rows) / vmin (text).
{
  "vars": {
    "color.bg":       { "by": "finish", "flat": "#000000", "frame": "#141414", "metal": "#000000" },
    "color.text":     { "by": "accent", "white": "#ffffff", "black": "#101010", "red": "#e8484a", "yellow": "#f2c230",
                        "green": "#3cc860", "cyan": "#2f7ae0", "magenta": "#d048e0" },
    "color.dim":      { "by": "finish", "flat": "#8a8a8a", "frame": "#8a8a8a", "metal": "#303030" },
    "color.pill":     { "by": "finish", "flat": "#ffffff", "frame": "#00000000", "metal": "#00000000" },
    "color.pillText": { "by": "finish", "flat": "#000000", "frame": "#101418", "metal": "#101418" },
    // the finish's layers: the metal background, the screen's frame, the metal pill
    "metal.show": { "by": "finish", "flat": "none", "frame": "none", "metal": "flex" },
    "frame.show": { "by": "finish", "flat": "none", "frame": "flex", "metal": "none" },
    "shine.show": { "by": "finish", "flat": "none", "frame": "flex", "metal": "flex" },
    "shine.on":   { "by": "finish", "flat": "false", "frame": "true", "metal": "true" },
    "frame.w": "1.6vmin",
    "color.hint": "#2a2a2a",
    "color.panel": "#1c1c1c",
    "color.dimLayer": "#000000c0",
    "font.main": ":/Rubik-Regular.ttf",
    "row.h": "12.5vh",
    "text.size": "6.2vh",
    "small.size": "4.6vh",
    "edge": "3vw"
  }
}
