// Dialogs. dialog.kind: "msgbox" (a question, a notice: centred, its buttons under it),
// "panel" (full screen: a title and what the dialog has: text, tiles, a field and its
// keyboard, a busy spinner, a progress bar, buttons), "viewer" (a game's image / video).
{
  "views": {
    "dialog": { "id": "dialog", "style": { "width": "100%", "height": "100%" }, "children": [
      { "type": "box", "id": "dim",
        "style": { "position": "absolute", "left": 0, "top": 0, "width": "100%", "height": "100%", "background": "$color.dimLayer" } },

      { "type": "box", "id": "msgbox",
        "style": { "position": "absolute", "left": "50%", "top": "50%", "translate": ["-50%", "-50%"], "width": "88vw", "maxHeight": "80vh",
                   "flexDirection": "column", "alignItems": "center", "padding": ["4vh", "4vw", "3vh", "4vw"],
                   "background": "$color.panel", "borderRadius": "4vmin",
                   "display": "{dialog.kind == \"msgbox\" ? \"flex\" : \"none\"}" },
        "children": [
          { "type": "text", "id": "message", "text": "{dialog.text}", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
            "wrap": true, "align": "center", "lineHeight": 1.3,
            "style": { "width": "100%", "flexShrink": 1, "color": "$color.text" } },
          { "use": "dialogButtons" }
        ] },

      { "type": "box", "id": "panel",
        "style": { "position": "absolute", "left": 0, "top": 0, "width": "100%", "height": "100%", "background": "$color.bg",
                   "flexDirection": "column", "padding": [0, "$edge", "$row.h", "$edge"],
                   "display": "{dialog.kind == \"panel\" ? \"flex\" : \"none\"}" },
        "children": [
          { "type": "text", "id": "panelTitle", "text": "{upper(dialog.title)}", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
            "valign": "center", "ellipsis": true, "style": { "height": "$row.h", "flexShrink": 0, "color": "$color.dim" } },
          { "type": "box", "id": "above", "style": { "flexGrow": "{dialog.tiles > 0 || dialog.keys > 0 || dialog.hasField ? 0 : 1}" } },
          { "type": "text", "id": "panelText", "text": "{dialog.text}", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
            "wrap": true, "lineHeight": 1.3, "scroll": "vertical",
            "align": "center",
            "style": { "width": "100%", "flexShrink": 1, "minHeight": 0, "color": "$color.text", "margin": [0, 0, "2vh", 0],
                       "display": "{dialog.text != \"\" && !dialog.textLeft ? \"flex\" : \"none\"}" } },
          { "type": "text", "id": "panelTextLeft", "text": "{dialog.text}", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
            "wrap": true, "lineHeight": 1.3, "scroll": "vertical",
            "align": "left",
            "style": { "width": "100%", "flexShrink": 1, "minHeight": 0, "color": "$color.text", "margin": [0, 0, "2vh", 0],
                       "display": "{dialog.text != \"\" && dialog.textLeft ? \"flex\" : \"none\"}" } },
          { "type": "repeat", "id": "tiles", "source": "dialogTiles", "grid": { "columns": "{dialog.tileColumns}" }, "cursor": { "scroll": "row" },
            "style": { "flexDirection": "row", "flexGrow": 1, "flexShrink": 1, "minHeight": 0, "columnGap": "2vw", "overflow": "hidden",
                       "display": "{dialog.tiles > 0 ? \"flex\" : \"none\"}" },
            "template": { "use": "pill", "id": "tile",
              "style": { "flexDirection": "column", "height": "{screen.h * 0.36}", "borderRadius": "3vmin", "padding": "1vmin" },
              "children": [
                { "type": "image", "id": "tileImage", "src": "{item.image}", "fit": "contain", "style": { "width": "100%", "flexGrow": 1, "minHeight": 0 } },
                { "use": "label", "text": "{item.label}", "fontMenu": true, "align": "center", "fontSize": "$small.size", "style": { "width": "100%", "flexShrink": 0 } }
              ] } },
          { "type": "box", "id": "field",
            "style": { "height": "{screen.h * (dialog.fieldMultiLine ? 0.4 : 0.1)}", "flexShrink": 0, "overflow": "hidden",
                       "background": "$color.panel", "borderRadius": "2vmin", "margin": [0, 0, "2vh", 0],
                       "display": "{dialog.hasField ? \"flex\" : \"none\"}" },
            "children": [
              { "type": "text", "id": "fieldValue", "text": "{dialog.fieldValue}", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
                "valign": "center",
                "style": { "position": "absolute", "top": 0, "height": "100%", "color": "$color.text",
                           "left": "{screen.w * 0.02 - max(0, textWidth(dialog.fieldBeforeCursor) - screen.w * 0.86)}",
                           "display": "{dialog.fieldMultiLine ? \"none\" : \"flex\"}" } },
              { "type": "text", "id": "fieldText", "text": "{dialog.fieldMultiText}", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
                "wrap": true, "lineHeight": 1.3,
                "style": { "position": "absolute", "left": "2vw", "right": "2vw", "top": "1vh", "bottom": "1vh", "color": "$color.text",
                           "display": "{dialog.fieldMultiLine ? \"flex\" : \"none\"}" } },
              { "type": "box", "id": "cursor", "font": "$font.main", "fontMenu": true, "fontSize": "$small.size",
                "style": { "position": "absolute", "top": "20%", "width": 2, "height": "60%", "background": "$color.text",
                           "left": "{screen.w * 0.02 + textWidth(dialog.fieldBeforeCursor) - max(0, textWidth(dialog.fieldBeforeCursor) - screen.w * 0.86)}",
                           "opacity": "{dialog.fieldEditing ? 1 : 0.3}",
                           "display": "{dialog.fieldMultiLine ? \"none\" : \"flex\"}" } }
            ] },
          { "type": "repeat", "id": "keys", "source": "dialogKeys", "cursor": { "scroll": "row" },
            "style": { "height": "{screen.h * 0.09 * dialog.keyRows}", "flexShrink": 0,
                       "display": "{dialog.keys > 0 ? \"flex\" : \"none\"}" },
            "template": { "type": "box", "id": "key",
              "style": { "position": "absolute", "padding": "0.4vmin",
                         "left": "{item.col * screen.w * 0.94 / max(1, dialog.keyCols)}", "top": "{item.row * screen.h * 0.09}",
                         "width": "{item.colSpan * screen.w * 0.94 / max(1, dialog.keyCols)}", "height": "{item.rowSpan * screen.h * 0.09}" },
              "children": [
                { "type": "box", "id": "keyCell",
                  "style": { "width": "100%", "height": "100%", "justifyContent": "center", "alignItems": "center",
                             "background": "$color.hint", "borderRadius": "1.5vmin" },
                  "states": { "selected": { "style": { "background": "$color.pill" } } },
                  "children": [ { "use": "label", "text": "{item.label}", "fontMenu": true, "fontSize": "$small.size", "align": "center" } ] }
              ] } },
          { "type": "image", "id": "busy", "src": ":/busy_0.svg", "fit": "contain", "tint": "$color.text",
            "style": { "height": "$text.size", "alignSelf": "center", "margin": ["2vh", 0, 0, 0], "display": "{dialog.busy ? \"flex\" : \"none\"}" } },
          { "type": "box", "id": "progress",
            "style": { "height": "1.6vh", "flexShrink": 0, "background": "$color.hint", "borderRadius": "50%", "overflow": "hidden",
                       "margin": ["2vh", 0, 0, 0], "display": "{dialog.progress >= 0 ? \"flex\" : \"none\"}" },
            "children": [
              { "type": "box", "id": "progressFill",
                "style": { "height": "100%", "width": "{max(0, dialog.progress) * screen.w * 0.94}", "background": "$color.pill" } } ] },
          { "type": "box", "id": "spacer", "style": { "flexGrow": 1 } },
          { "use": "dialogButtons" }
        ] },

      { "type": "box", "id": "viewer",
        "style": { "position": "absolute", "left": 0, "top": 0, "width": "100%", "height": "100%", "background": "$color.bg",
                   "display": "{dialog.kind == \"viewer\" ? \"flex\" : \"none\"}" },
        "children": [
          { "type": "image", "id": "viewerImage", "src": "{dialog.image}", "fit": "contain",
            "style": { "position": "absolute", "left": 0, "top": 0, "width": "100%", "height": "100%",
                       "display": "{dialog.imageW <= 0 && dialog.video == \"\" ? \"flex\" : \"none\"}" } },
          { "type": "image", "id": "viewerZoom", "src": "{dialog.image}", "fit": "fill",
            "style": { "position": "absolute", "left": "{dialog.imageX}", "top": "{dialog.imageY}", "width": "{dialog.imageW}", "height": "{dialog.imageH}",
                       "display": "{dialog.imageW > 0 ? \"flex\" : \"none\"}" } },
          { "type": "video", "id": "viewerVideo", "src": "{dialog.video}", "fit": "contain",
            "style": { "position": "absolute", "left": 0, "top": 0, "width": "100%", "height": "100%",
                       "display": "{dialog.video != \"\" ? \"flex\" : \"none\"}" } }
        ] },

      { "use": "help", "source": "menuHelp" }
    ] }
  }
}
