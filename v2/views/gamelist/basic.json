// A system's games: the list left, the selected game's art right.
{
  "views": {
    "gamelist/basic": { "id": "basic", "style": { "width": "100%", "height": "100%" }, "children": [
      { "use": "bg" },
      { "use": "title", "text": "{upper(system.fullName)}" },
      { "type": "image", "id": "artFrame", "src": "art/metal.jpg", "fit": "cover",
        "style": { "position": "absolute", "right": "$edge", "top": "$row.h", "width": "40vw", "height": "75vh",
                   "display": "{$(shine.on) && firstFile(game.thumbnail, game.image) != \"\" ? \"flex\" : \"none\"}" } },
      { "type": "image", "id": "art", "src": "{firstFile(game.thumbnail, game.image)}", "fit": "contain",
        "style": { "position": "absolute", "right": "{screen.w * ($(shine.on) ? 0.045 : 0.03)}", "top": "{screen.h * ($(shine.on) ? 0.145 : 0.125)}",
                   "width": "{screen.w * ($(shine.on) ? 0.37 : 0.40)}", "height": "{screen.h * ($(shine.on) ? 0.71 : 0.75)}" } },
      { "type": "repeat", "id": "games", "source": "games", "cursor": { "scroll": "row" },
        "style": { "position": "absolute", "left": "$edge", "top": "$row.h", "width": "{screen.w * (firstFile(game.thumbnail, game.image) != \"\" ? 0.52 : 0.94)}", "height": "75vh",
                   "flexDirection": "column", "overflow": "hidden" },
        "template": { "use": "row", "children": [
          { "use": "pill", "children": [ { "use": "shine" }, { "use": "label", "text": "{item.name}" } ] } ] } },
      { "use": "help" }
    ] }
  }
}
